# All optional. DOOFUS works with zero keys (offline roasts, link-only GIFs, blank templates).

# GIFs
GIPHY_API_KEY=        # free: developers.giphy.com

# Captioned memes
IMGFLIP_API_KEY=      # free: imgflip.com/api-settings

# Roasts — bring any LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=         # any OpenAI-compatible API: OpenRouter, Groq, Ollama (http://localhost:11434/v1), Hermes on vLLM...
DOOFUS_MODEL=         # e.g. claude-haiku-4-5-20251001, gpt-4o-mini, nousresearch/hermes-4-70b

# Chat apps
TELEGRAM_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
