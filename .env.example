# All optional. DOOFUS works with zero keys (offline roasts, link-only GIFs, blank templates).

# GIFs
GIPHY_API_KEY=        # free: developers.giphy.com

# Captioned memes
IMGFLIP_API_KEY=      # free: imgflip.com/api-settings

# Roasts — bring any LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=         # any OpenAI-compatible API: OpenRouter, Groq, Ollama (http://localhost:11434/v1), Hermes on vLLM...
DOOFUS_MODEL=         # e.g. claude-haiku-4-5-20251001, gpt-4o-mini, nousresearch/hermes-4-70b

# Chat apps
TELEGRAM_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=      # xoxb-... so he can talk in channels and react with emoji

# Behavior
DOOFUS_REACT=on       # emoji reactions on channel messages (on/off)
DOOFUS_CHAOS=0.03     # chance he jumps into a conversation uninvited (0 = never, 1 = always, good luck)
DOOFUS_SITE=          # where sound links point (default: https://eddielobanovskiy.github.io/doofus/)
DOOFSPEAK=1           # funny spelling: 0 = off, 1 = normal, 2 = unhinged
